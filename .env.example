# Native Next.js + Neon PostgreSQL
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
# Same-origin API paths; normally leave these unset.
API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=

# OAuth credentials — create separate OAuth clients for local and production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
LINKEDIN_API_VERSION=
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_AGENT_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=120
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# Comma-separated exact OIDC identities in issuer|subject format.
# Example shape only; replace with the actual issuer and immutable sub claim.
ADMIN_ALLOWED_SUBJECTS=

# Private resume tailoring (OpenAI-compatible chat completions endpoint)
RESUME_AI_BASE_URL=
RESUME_AI_API_KEY=
RESUME_AI_MODEL=

# AI-screened contact form (OpenAI-compatible chat completions endpoint)
CONTACT_AI_BASE_URL=
CONTACT_AI_API_KEY=
CONTACT_AI_MODEL=
CONTACT_AI_PATH=/v1/chat/completions
CONTACT_IP_HASH_SALT=
RATE_LIMIT_CONTACT_PER_MINUTE=4

# Outbound Gmail SMTP. Use a Google App Password, never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_INBOX_EMAIL=bchbenjamin@gmail.com
CONTACT_NOTIFICATION_CC=
CONTACT_RETENTION_DAYS=180
CONTACT_MAINTENANCE_ENABLED=false
CRON_SECRET=

